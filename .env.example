# --- Panorama sources (all optional; with none set, the built-in synthetic demo street is used) ---
# Google Map Tiles API key (Street View tiles + metadata). Read the licensing note in README.md first.
GOOGLE_MAPS_API_KEY=
# Mapillary client token (CC-BY-SA imagery, explicitly allows derived 3D works)
MAPILLARY_ACCESS_TOKEN=

# --- Road network ---
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --- Monocular depth (Dataset B) ---
# "auto" = transformers if torch is installed, else deterministic fallback; or "transformers" / "mock"
AI_DEPTH_BACKEND=auto
AI_DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-Small-hf
# panorama | cubemap (cubemap = per-face inference, preferred for precision)
AI_DEPTH_MODE=cubemap

# --- Validation ---
DEFAULT_DISCREPANCY_THRESHOLD_M=0.85
DEFAULT_FUSION_ALPHA=0.75
CAMERA_HEIGHT_M=2.5

# --- Imagery / export ---
DEFAULT_CUBEMAP_FACE_SIZE=1024
PANO_ZOOM=4
DEPTH_WORK_WIDTH=1024
EXPORT_WORK_DIR=./exports

# --- DEM ---
# auto = OpenTopography (if key) -> AWS Terrarium tiles (no key)
DEM_SOURCE=auto
OPENTOPOGRAPHY_API_KEY=
